# Example configuration. Copy to `.env` and edit if you need to override defaults.
#
#   cp .env.example .env
#
# Every setting already has a sensible default in `src/copilot/config.py`, so the
# project runs out of the box without a `.env` file at all. All variables are read
# with the `COPILOT_` prefix (see pydantic-settings config).

# --- Ollama (local models) ---
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_LLM_MODEL=llama3.2:3b
COPILOT_EMBEDDING_MODEL=nomic-embed-text

# --- Vector store ---
COPILOT_COLLECTION_NAME=maintenance_manuals

# --- RAG parameters ---
COPILOT_CHUNK_SIZE=800
COPILOT_CHUNK_OVERLAP=120
COPILOT_RETRIEVAL_K=4

# --- Agent (self-correction budget) ---
COPILOT_MAX_REWRITES=2
COPILOT_MAX_GENERATIONS=2

# --- Robustness (calls to Ollama) ---
COPILOT_LLM_TIMEOUT=120
COPILOT_LLM_MAX_ATTEMPTS=3

# --- Observability ---
COPILOT_LOG_LEVEL=INFO
# Arize Phoenix tracing: start the server first (see README), then set this to true.
COPILOT_TRACING_ENABLED=false
COPILOT_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
COPILOT_PHOENIX_PROJECT=agentic-rag-copilot
